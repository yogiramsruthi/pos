generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  STAFF
}

enum InvoiceStatus {
  HELD
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
  REFUNDED
}

enum PaymentMode {
  CASH
  CARD
  UPI
  WALLET
  SPLIT
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  PENDING
  COMPLETED
}

enum CashMovementType {
  OPENING
  SALE
  REFUND
  EXPENSE
  CASH_IN
  CASH_OUT
  CLOSING
}

model User {
  id           String              @id @default(uuid())
  name         String
  email        String              @unique
  passwordHash String
  phone        String?
  role         UserRole
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  openedCash   CashRegisterSession[] @relation("OpenedBy")
  closedCash   CashRegisterSession[] @relation("ClosedBy")
  auditLogs    AuditLog[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  customerDiscounts CustomerDiscount[]

  @@unique([name, parentId])
}

model Product {
  id          String           @id @default(uuid())
  name        String
  sku         String           @unique
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  brand       String?
  fabric      String?
  description String?
  hsnCode     String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@index([name])
}

model ProductVariant {
  id             String           @id @default(uuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id])
  barcode        String           @unique
  sizeLabel      String
  colorLabel     String
  costPrice      Decimal          @db.Decimal(10, 2)
  mrp            Decimal          @db.Decimal(10, 2)
  sellingPrice   Decimal          @db.Decimal(10, 2)
  taxPercent     Decimal          @db.Decimal(5, 2)
  reorderLevel   Int              @default(5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  stocks         InventoryStock[]
  movements      StockMovement[]
  invoiceLines   InvoiceLine[]
  purchaseLines  PurchaseOrderItem[]

  @@unique([productId, sizeLabel, colorLabel])
  @@index([sizeLabel, colorLabel])
}

model Warehouse {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  address     String?
  isPrimary   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  stocks      InventoryStock[]
  movements   StockMovement[]
  invoices    Invoice[]
  purchases   PurchaseOrder[]

  @@index([name])
}

model InventoryStock {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  quantityOnHand   Int            @default(0)
  quantityReserved Int            @default(0)
  updatedAt        DateTime       @updatedAt

  @@unique([warehouseId, productVariantId])
  @@index([quantityOnHand])
}

model StockMovement {
  id               String            @id @default(uuid())
  productVariantId String
  variant          ProductVariant    @relation(fields: [productVariantId], references: [id])
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  movementType     StockMovementType
  quantity         Int
  referenceType    String?
  referenceId      String?
  reason           String?
  createdByUserId  String?
  createdAt        DateTime          @default(now())

  @@index([movementType, createdAt])
}

model MembershipTier {
  id               String      @id @default(uuid())
  name             String      @unique
  discountPercent  Decimal     @default(0) @db.Decimal(5, 2)
  pointsMultiplier Decimal     @default(1) @db.Decimal(5, 2)
  customers        Customer[]
}

model Customer {
  id                     String             @id @default(uuid())
  name                   String
  phone                  String             @unique
  email                  String?
  address                String?
  loyaltyPoints          Int                @default(0)
  creditBalance          Decimal            @default(0) @db.Decimal(10, 2)
  defaultDiscountPercent Decimal            @default(0) @db.Decimal(5, 2)
  tierId                 String?
  tier                   MembershipTier?    @relation(fields: [tierId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  invoices               Invoice[]
  discounts              CustomerDiscount[]

  @@index([name])
}

model CustomerDiscount {
  id             String    @id @default(uuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  discountType   String
  discountValue  Decimal   @db.Decimal(10, 2)
  validFrom      DateTime?
  validTo        DateTime?
  stackable      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([customerId, validFrom, validTo])
}

model Coupon {
  id              String   @id @default(uuid())
  code            String   @unique
  discountType    String
  discountValue   Decimal  @db.Decimal(10, 2)
  maxUsageCount   Int?
  usageCount      Int      @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  minBillAmount   Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Invoice {
  id                 String         @id @default(uuid())
  invoiceNumber      String         @unique
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  warehouseId        String
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id])
  status             InvoiceStatus  @default(COMPLETED)
  paymentStatus      PaymentStatus  @default(DUE)
  subtotalAmount     Decimal        @db.Decimal(12, 2)
  itemDiscountAmount Decimal        @default(0) @db.Decimal(12, 2)
  billDiscountAmount Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0) @db.Decimal(12, 2)
  roundOffAmount     Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal        @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lines              InvoiceLine[]
  payments           Payment[]
  returns            ReturnOrder[]

  @@index([createdAt])
}

model InvoiceLine {
  id             String         @id @default(uuid())
  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id])
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPrice      Decimal        @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @db.Decimal(10, 2)
  taxRate        Decimal        @db.Decimal(5, 2)
  taxAmount      Decimal        @db.Decimal(10, 2)
  lineTotal      Decimal        @db.Decimal(10, 2)
}

model Payment {
  id             String      @id @default(uuid())
  invoiceId      String
  invoice        Invoice     @relation(fields: [invoiceId], references: [id])
  mode           PaymentMode
  amount         Decimal     @db.Decimal(10, 2)
  referenceNo    String?
  createdAt      DateTime    @default(now())
}

model HeldSale {
  id              String      @id @default(uuid())
  holdReference   String      @unique
  cartPayload     Json
  customerId      String?
  heldByUserId    String?
  heldAt          DateTime    @default(now())
  resumedAt       DateTime?
}

model ReturnOrder {
  id                String      @id @default(uuid())
  originalInvoiceId String
  originalInvoice   Invoice     @relation(fields: [originalInvoiceId], references: [id])
  returnInvoiceId   String?
  reason            String?
  refundAmount      Decimal     @db.Decimal(10, 2)
  createdAt         DateTime    @default(now())
}

model Supplier {
  id               String          @id @default(uuid())
  name             String
  phone            String?
  email            String?
  address          String?
  gstNumber        String?
  outstandingDue   Decimal         @default(0) @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  purchaseOrders   PurchaseOrder[]

  @@index([name])
}

model PurchaseOrder {
  id              String               @id @default(uuid())
  poNumber        String               @unique
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  status          PurchaseOrderStatus  @default(DRAFT)
  expectedDate    DateTime?
  subtotalAmount  Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal              @default(0) @db.Decimal(12, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String         @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  orderedQty      Int
  receivedQty     Int            @default(0)
  unitCost        Decimal        @db.Decimal(10, 2)
  taxRate         Decimal        @db.Decimal(5, 2)
  lineTotal       Decimal        @db.Decimal(10, 2)
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  grnNumber       String             @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  status          GoodsReceiptStatus @default(PENDING)
  receivedAt      DateTime?
  createdAt       DateTime           @default(now())
}

model CashRegisterSession {
  id               String         @id @default(uuid())
  openedByUserId   String?
  openedBy         User?          @relation("OpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId   String?
  closedBy         User?          @relation("ClosedBy", fields: [closedByUserId], references: [id])
  openingBalance   Decimal        @db.Decimal(10, 2)
  closingBalance   Decimal?       @db.Decimal(10, 2)
  expectedBalance  Decimal?       @db.Decimal(10, 2)
  discrepancy      Decimal?       @db.Decimal(10, 2)
  openedAt         DateTime       @default(now())
  closedAt         DateTime?
  notes            String?
  movements        CashMovement[]
}

model CashMovement {
  id              String            @id @default(uuid())
  sessionId       String
  session         CashRegisterSession @relation(fields: [sessionId], references: [id])
  movementType    CashMovementType
  amount          Decimal           @db.Decimal(10, 2)
  notes           String?
  referenceType   String?
  referenceId     String?
  createdAt       DateTime          @default(now())

  @@index([movementType, createdAt])
}

model Expense {
  id              String      @id @default(uuid())
  category        String
  amount          Decimal     @db.Decimal(10, 2)
  notes           String?
  expenseDate     DateTime
  createdAt       DateTime    @default(now())
}

model InvoiceSequence {
  key          String   @id
  currentValue Int
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  action        String
  entityType    String
  entityId      String?
  beforeData    Json?
  afterData     Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SyncEvent {
  id             String   @id @default(uuid())
  deviceId       String
  operation      String
  entityType     String
  entityId       String
  payload        Json
  status         String   @default("PENDING")
  retryCount     Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceId, status])
}
